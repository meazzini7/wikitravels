rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if resource.data.status == 'published'
        || (request.auth != null && request.auth.uid == resource.data.authorId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      match /stops/{stopId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.status == 'published'
          || (request.auth != null
              && request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.authorId);
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.authorId;
      }
    }

    // Le altre collezioni (follows, chats, notifications, articles, ...)
    // vengono aggiunte con le loro regole man mano che gli step successivi
    // le creano.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
