rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Il proprietario può modificare tutto il proprio profilo. Un altro
      // utente autenticato può SOLO incrementare/decrementare
      // stats.followersCount (serve per il follow/unfollow lato client).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
          && request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['followersCount'])
        )
      );
      allow delete: if false;

      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.followerId
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /trips/{tripId} {
      // Anteprima (titolo, copertina, date, km...) visibile a chiunque se il
      // viaggio è pubblico e pubblicato; sempre visibile al proprietario.
      // Tappe/mappa (subcollection sotto) richiedono invece login anche per
      // i viaggi pubblici; i viaggi privati non sono mai visibili ad altri.
      allow read: if (resource.data.visibility == 'public' && resource.data.status == 'published')
        || (request.auth != null && request.auth.uid == resource.data.authorId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      match /stops/{stopId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.authorId
          || (get(/databases/$(database)/documents/trips/$(tripId)).data.visibility == 'public'
              && get(/databases/$(database)/documents/trips/$(tripId)).data.status == 'published')
        );
        // NON usare get() sul viaggio padre qui: viaggio e tappe vengono
        // creati nella stessa scrittura batch, quindi al momento della
        // valutazione della regola il documento trip potrebbe non esistere
        // ancora e get() farebbe fallire l'intero batch. Il campo authorId
        // è denormalizzato su ogni tappa proprio per evitare questo.
        allow create, update: if request.auth != null
          && request.auth.uid == request.resource.data.authorId;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /articles/{articleId} {
      // Generati e scritti solo dal cron server-side (Admin SDK, che
      // bypassa le regole): dal client si può solo leggere il pubblicato.
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
