rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Le altre collezioni (trips, follows, chats, articles, ...) vengono
    // aggiunte con le loro regole man mano che gli step successivi le creano.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
