rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Copertine viaggio caricate manualmente dall'utente (alternativa alla
    // generazione AI): leggibili da chiunque (servono nelle card pubbliche),
    // scrivibili solo dal proprietario del proprio percorso uid.
    match /trips/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
