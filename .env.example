# Copia questo file in .env.local e riempi con le TUE chiavi RIGENERATE.
# .env.local non va mai committato (è già in .gitignore).

# --- Firebase client (pubbliche, visibili nel browser: ok, non sono segrete) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wikitravels.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wikitravels
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wikitravels.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=867232079316
NEXT_PUBLIC_FIREBASE_APP_ID=1:867232079316:web:37bfff7edb724547a78a41

# --- Firebase Admin (SEGRETE, solo lato server) ---
# OPZIONE A (la più semplice): incolla qui l'INTERO file JSON del service
# account scaricato da Firebase Console, così com'è, senza modificarlo.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# OPZIONE B: lo stesso JSON codificato in base64 (un unico blocco senza
# ritorni a capo). Ha effetto solo se l'opzione A è vuota.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# OPZIONE C: le due variabili separate (più fragile: FIREBASE_ADMIN_PRIVATE_KEY
# va incollata con i \n letterali esattamente come appaiono nel campo
# "private_key" del JSON, senza le virgolette esterne). Usata solo se A e B
# sono entrambe vuote.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- AI / immagini (SEGRETE) ---
GEMINI_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Cron protection ---
CRON_SECRET=scegli-una-stringa-lunga-e-casuale

# --- Report email giornaliero (Resend, opzionale: senza questa chiave il
#     cron gira comunque ma non invia nulla, vedi HANDOFF sezione 6) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=WikiTravels <onboarding@resend.dev>
ADMIN_REPORT_EMAIL=meazzini7@gmail.com

# --- SEO ---
NEXT_PUBLIC_SITE_URL=https://www.tuodominio.it
GOOGLE_SITE_VERIFICATION=
